{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "AWS": {
    "Profile": "default",
    "Region": "ap-southeast-2"
  },
  "TenantApps": {
    "_comment": "Base URL per app. Normally nothing to set: built from the address the dashboard was opened on (first label swapped for the app; only under RootDomain). UrlTemplate ({app}, {tenant} = TenantCode claim) overrides; TenantURL (Hub style, 'app_name') and https://{app}.{Domain env} are fallbacks.",
    "UrlTemplate": "",
    "Hosts": {
      "Settings": "dfrntdriveconfig",
      "RoutedOps": "routedoperations",
      "IntegrationManager": "integrationmanager"
    },
    "WarmUpMinutes": 360,
    "TimeoutSeconds": 60
  }
}