<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources.

     nuget.org: public packages.
     gitlab-accesscontrol: DeliverDifferent.AccessControl (gitlab.com project
       87503559). The shared Access Control switches; Setup Dashboard uses
       [RequireFeature] so the hub-tile-setup-dashboard switch blocks the app,
       not just the tile. This project must be on that project's inbound
       job-token allowlist; without it restore fails NU1101.

     Restore credentials come from env vars GITLAB_NUGET_USERNAME +
     GITLAB_NUGET_TOKEN. Local dev sets these in the developer's shell; CI
     sets them in .gitlab-ci.yml and forwards them to the Docker build. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="gitlab-accesscontrol" value="https://gitlab.com/api/v4/projects/87503559/packages/nuget/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <gitlab-accesscontrol>
      <add key="Username" value="%GITLAB_NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%GITLAB_NUGET_TOKEN%" />
    </gitlab-accesscontrol>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="gitlab-accesscontrol">
      <package pattern="DeliverDifferent.AccessControl" />
    </packageSource>
  </packageSourceMapping>
</configuration>
