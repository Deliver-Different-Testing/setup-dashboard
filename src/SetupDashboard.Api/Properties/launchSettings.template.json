{
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://setupdashboard.local.deliverdifferent.com:5200"
    }
  },
  "profiles": {
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "launchUrl": "setup-dashboard/",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SQLHealthCheckConnection": "Server=<sql-server>;database=master-controller-seed;uid=<sql-user>;pwd=<sql-password>;TrustServerCertificate=True",
        "MasterSQLConnection": "Server=<sql-server>;database=master-controller-seed;uid=<sql-user>;pwd=<sql-password>;TrustServerCertificate=True",
        "SQLCredentials": "user id=<sql-user>;password=<sql-password>",
        "PublicPath": "http://hub.local.deliverdifferent.com:51532/Account/login",
        "RedisConfig": "<redis-host>:<port>,password=<redis-password>",
        "Domain": "local.deliverdifferent.com",
        "ANTHROPIC_API_KEY": "<anthropic-api-key - dfrntcrm launchSettings AutoMate__Anthropic__ApiKey>"
      }
    },
    "SetupDashboard.Api": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "setup-dashboard/",
      "applicationUrl": "https://localhost:7200;http://localhost:5200",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SQLHealthCheckConnection": "Server=<sql-server>;database=master-controller-seed;uid=<sql-user>;pwd=<sql-password>;TrustServerCertificate=True",
        "MasterSQLConnection": "Server=<sql-server>;database=master-controller-seed;uid=<sql-user>;pwd=<sql-password>;TrustServerCertificate=True",
        "SQLCredentials": "user id=<sql-user>;password=<sql-password>",
        "PublicPath": "http://hub.local.deliverdifferent.com:51532/Account/login",
        "RedisConfig": "<redis-host>:<port>,password=<redis-password>",
        "Domain": "local.deliverdifferent.com",
        "ANTHROPIC_API_KEY": "<anthropic-api-key - dfrntcrm launchSettings AutoMate__Anthropic__ApiKey>"
      }
    }
  }
}
